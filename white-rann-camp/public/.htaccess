# White Rann Camp website on Hostinger (Apache/LiteSpeed). Vite copies this file into dist/.
# HTTPS is forced from hPanel (Security -> SSL -> Force HTTPS), not here, so the site still opens
# while the free certificate is being issued.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Real files and folders (photos, assets, favicon) are served as they are.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Every other address (/tents, /gallery, ...) is a page of the site: hand it to index.html.
  RewriteRule ^ index.html [L]
</IfModule>

# The built scripts and styles have a fingerprint in their names, so they can be cached for a year.
# index.html is never cached, so a new upload shows at once.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
